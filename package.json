{
  "name": "routemark",
  "version": "0.3.2",
  "description": "Browse every REST API route on your site and send test requests to it from wp-admin.",
  "private": true,
  "license": "GPL-2.0-or-later",
  "author": "CC Software",
  "homepage": "https://github.com/ClearanceClarence-Software/Routemark",
  "repository": {
    "type": "git",
    "url": "https://github.com/ClearanceClarence-Software/Routemark.git"
  },
  "bugs": "https://github.com/ClearanceClarence-Software/Routemark/issues",
  "files": [
    "routemark.php",
    "uninstall.php",
    "includes",
    "build",
    "licenses",
    "readme.txt"
  ],
  "scripts": {
    "build": "wp-scripts build src/index.tsx",
    "start": "wp-scripts start src/index.tsx",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/e2e",
    "lint:js": "wp-scripts lint-js src",
    "zip": "npm run build && node scripts/zip.mjs",
    "env:start": "wp-env start",
    "env:stop": "wp-env stop",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wordpress/env": "^12.0.0",
    "@wordpress/scripts": "^35.0.0",
    "archiver": "^7.0.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@wordpress/api-fetch": "^8.0.0",
    "@wordpress/element": "^10.0.0",
    "@wordpress/hooks": "^4.57.0",
    "@wordpress/i18n": "^7.0.0",
    "@wordpress/url": "^5.0.0"
  }
}
