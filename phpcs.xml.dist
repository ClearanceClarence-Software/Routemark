<?xml version="1.0"?>
<ruleset name="Routemark">
	<description>WordPress Coding Standards, including the escaping, sanitizing and nonce checks.</description>

	<file>routemark.php</file>
	<file>uninstall.php</file>
	<file>includes</file>

	<arg name="extensions" value="php"/>
	<arg value="sp"/>

	<rule ref="WordPress"/>

	<config name="minimum_wp_version" value="6.6"/>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="routemark"/>
			</property>
		</properties>
	</rule>
</ruleset>
